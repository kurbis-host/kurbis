@@ -123,0 +193,40 @@ impl NetherNetListener {
+#[cfg(test)]
+mod gateway_config_tests {
+    use super::{configured_external_ip, configured_external_port};
+    use std::net::IpAddr;
+
+    #[test]
+    fn explicit_public_address_and_port_override_environment_values() {
+        assert_eq!(
+            configured_external_ip(
+                Some("192.0.2.10".parse::<IpAddr>().unwrap()),
+                Some("invalid"),
+            )
+            .unwrap(),
+            Some("192.0.2.10".parse().unwrap())
+        );
+        assert_eq!(
+            configured_external_port(Some(19132), Some("invalid")).unwrap(),
+            Some(19132)
+        );
+    }
+
+    #[test]
+    fn environment_public_address_and_port_are_validated() {
+        assert_eq!(configured_external_ip(None, Some("  ")).unwrap(), None);
+        assert_eq!(
+            configured_external_ip(None, Some("192.0.2.10")).unwrap(),
+            Some("192.0.2.10".parse().unwrap())
+        );
+        assert_eq!(configured_external_port(None, None).unwrap(), None);
+        assert_eq!(
+            configured_external_port(None, Some("19132")).unwrap(),
+            Some(19132)
+        );
+        assert!(configured_external_ip(None, Some("not-an-ip")).is_err());
+        assert!(configured_external_ip(None, Some("0.0.0.0")).is_err());
+        assert!(configured_external_port(None, Some("zero")).is_err());
+        assert!(configured_external_port(None, Some("0")).is_err());
+    }
+}

@@ -33,0 +37,49 @@ const MAX_SDP_SIZE: usize = 1 << 20;
+fn configured_external_ip(
+    configured: Option<IpAddr>,
+    environment: Option<&str>,
+) -> std::io::Result<Option<IpAddr>> {
+    let Some(value) = configured.map_or_else(
+        || {
+            environment
+                .map(str::trim)
+                .filter(|value| !value.is_empty())
+                .map(str::to_owned)
+        },
+        |address| Some(address.to_string()),
+    ) else {
+        return Ok(None);
+    };
+    let address = value
+        .parse::<IpAddr>()
+        .map_err(|error| std::io::Error::new(std::io::ErrorKind::InvalidInput, error))?;
+    if address.is_unspecified() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "external_ip cannot be unspecified",
+        ));
+    }
+    Ok(Some(address))
+}
+
+fn configured_external_port(
+    configured: Option<u16>,
+    environment: Option<&str>,
+) -> std::io::Result<Option<u16>> {
+    let port = match configured {
+        Some(port) => Some(port),
+        None => environment
+            .map(str::trim)
+            .filter(|value| !value.is_empty())
+            .map(str::parse)
+            .transpose()
+            .map_err(|error| std::io::Error::new(std::io::ErrorKind::InvalidInput, error))?,
+    };
+    if port == Some(0) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "external_port must be non-zero",
+        ));
+    }
+    Ok(port)
+}

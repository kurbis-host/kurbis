+        // only for SendPacks; the old byte/status + short/count layout is gone.
+        let _ = String::read(reader)?;
+        if response == Self::STATUS_SEND_PACKS {
+            let count = VarUInt::read(reader)?.0;
+            if count > 1024 {
+                return Err(Error::new(
+                    ErrorKind::InvalidData,
+                    "too many resource pack IDs",
+                ));
+            }
+            for _ in 0..count {
+                let _ = String::read(reader)?;
+            }
+        }
+        Ok(Self { response })
+    }
+}

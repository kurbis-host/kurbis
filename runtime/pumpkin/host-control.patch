+    /// Await serialization and disk writes, including regions kept hot by watchers.
+    pub async fn save_for_snapshot(&self) -> Result<(), String> {
+        let chunks = self
+            .loaded_chunks
+            .iter()
+            .map(|entry| (*entry.key(), entry.value().clone()))
+            .collect();
+        self.chunk_saver
+            .save_chunks(&self.level_folder, chunks)
+            .await
+            .map_err(|error| format!("Chunk save failed: {error}"))?;
+
+        let entities = self
+            .loaded_entity_chunks
+            .iter()
+            .map(|entry| (*entry.key(), entry.value().clone()))
+            .collect();
+        self.entity_saver
+            .save_chunks(&self.level_folder, entities)
+            .await
+            .map_err(|error| format!("Entity save failed: {error}"))?;
+        Ok(())
+    }
+
     pub async fn shutdown(&self) {
         let world_id = self.level_folder.root_folder.display();
         info!("Saving level ({})...", world_id);

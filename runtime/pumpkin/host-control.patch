+fn write_block_list<W: Write>(writer: &mut W, blocks: &[String]) -> Result<(), Error> {
+    (blocks.len() as u32).write(writer)?;
+    for block in blocks {
+        let length = u16::try_from(block.len()).map_err(|_| Error::other("block name too long"))?;
+        length.write(writer)?;
+        writer.write_all(block.as_bytes())?;
+    }
+    Ok(())
+}
+
+fn read_block_list<R: Read>(reader: &mut R) -> Result<Vec<String>, Error> {
+    let count = u32::read(reader)?;
+    if count > 1024 {
+        return Err(Error::other("too many block names"));
+    }
+    let mut blocks = Vec::with_capacity(count as usize);
+    for _ in 0..count {
+        let length = u16::read(reader)?;
+        let mut bytes = vec![0; usize::from(length)];
+        reader.read_exact(&mut bytes)?;
+        blocks.push(String::from_utf8(bytes).map_err(Error::other)?);
+    }
+    Ok(blocks)
+}

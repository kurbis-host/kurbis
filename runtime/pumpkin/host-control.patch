     pub async fn kick(&self, reason: DisconnectReason, message: String) {
+        let first = self.output_sequence_number.load(Ordering::Relaxed);
         self.send_game_packet(&CDisconnectPlayer::new(reason as i32, message))
             .await;
+        let end = self.output_sequence_number.load(Ordering::Relaxed);
+        // The unreliable RakNet close must not overtake the reliable Minecraft
+        // disconnect. Keep retransmission/ACK handling alive until delivery or
+        // a bounded timeout; enqueue completion alone only confirms UDP send.
+        let _ = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            loop {
+                let pending = self
+                    .unacked_outgoing_frames
+                    .lock()
+                    .await
+                    .keys()
+                    .any(|seq| seq.wrapping_sub(first) < end.wrapping_sub(first));
+                if !pending || self.is_closed() {
+                    break;
+                }
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            }
+        })
+        .await;
         self.close().await;
     }
 

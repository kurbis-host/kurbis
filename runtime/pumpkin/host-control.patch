+    /// Load one plugin file, wait for its initialization and return its
+    /// metadata, or the reason it did not load.
+    pub async fn load_plugin_file(
+        self: &Arc<Self>,
+        server: &Arc<Server>,
+        path: &Path,
+    ) -> Result<PluginMetadata, String> {
+        let (name, task) = self
+            .start_loading_plugin(server, path)
+            .await
+            .map_err(|error| error.to_string())?;
+        task.await.map_err(|error| error.to_string())?;
+        match self.plugin_states.read().await.get(&name) {
+            Some(PluginState::Failed(error)) => return Err(error.clone()),
+            Some(PluginState::Loaded) => {}
+            _ => return Err(format!("plugin \"{name}\" did not finish loading")),
+        }
+        self.plugins
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .iter()
+            .find(|plugin| plugin.path == path && plugin.is_active)
+            .map(|plugin| plugin.metadata.clone())
+            .ok_or_else(|| format!("plugin \"{name}\" did not finish loading"))
+    }
+
+    /// The metadata and file of every loaded plugin.

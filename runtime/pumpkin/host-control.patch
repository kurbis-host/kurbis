+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .iter()
+            .map(|plugin| (plugin.metadata.clone(), plugin.path.clone()))
+            .collect()
+    }
+
+    /// A plugin's name names its data folder (`plugins/data/<name>`) and the
+    /// configuration that applies to it, so it must be one path component and
+    /// belong to one plugin only. Otherwise a plugin could take over the data
+    /// folder and the granted permissions of another.
+    fn ensure_loadable_name(&self, name: &str) -> Result<(), ManagerError> {
+        let valid = !name.is_empty()
+            && name.len() <= 64
+            && name != "."
+            && name != ".."
+            && name
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'));
+        if !valid {
+            return Err(ManagerError::LoaderError(LoaderError::RuntimeError(format!(
+                "plugin name {name:?} must be 1 to 64 letters, digits, '-', '_' or '.'"
+            ))));
+        }
+        if self.is_plugin_loaded(name) {
+            return Err(ManagerError::LoaderError(LoaderError::RuntimeError(format!(
+                "a plugin named \"{name}\" is already loaded"
+            ))));
+        }
+        Ok(())
+    }

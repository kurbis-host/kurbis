# Source from a shell after setting DATABASE_URL. Use a different ID/port range
# for each worker. Paths below assume this repository is the working directory.
export WORKER_RUNTIME=native
export PUMPKIN_BINARY="$PWD/output/native-pumpkin/target/debug/pumpkin"
export WORKER_ID=11111111-1111-4111-8111-111111111111
export WORKER_NAME=mac-development
export WORKER_ADDRESS=127.0.0.1
export WORKER_ROOT="$PWD/data/native-worker"
export WORKER_STORAGE_MODE=directory
export WORKER_MEMORY_GIB=8
export WORKER_DISK_GIB=30
export WORKER_CPU_MILLIS=4000
export WORKER_PORT_MIN=20000
export WORKER_PORT_MAX=20040
export PUMPKIN_HOST_CONTROL_TOKEN=replace-with-a-random-development-token
export OBJECT_STORE_TYPE=local
export OBJECT_STORE_LOCAL_ROOT="$PWD/data/objects"
export SNAPSHOT_INTERVAL_SECONDS=300
export IDLE_TIMEOUT_SECONDS=300

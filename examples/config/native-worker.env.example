# Generate a private per-worker bundle with `./start.sh worker-bundle` first.
# The bundle contains this worker's scoped control-plane token and runtime
# settings. Workers do not receive database or object-store credentials.
source "$PWD/data/worker-bundles/11111111-1111-4111-8111-111111111111.env"
export WORKER_RUNTIME=native
export PUMPKIN_BINARY="$PWD/output/native-pumpkin/target/debug/pumpkin"
export WORKER_ROOT="$PWD/data/native-worker"
export WORKER_STORAGE_MODE=directory
export WORKER_MEMORY_GIB=8
export WORKER_DISK_GIB=30
export WORKER_CPU_MILLIS=4000
export WORKER_PORT_MIN=20000
export WORKER_PORT_MAX=20040
export CONTROL_PLANE_URL=http://127.0.0.1:8080
export WORKER_ALLOW_INSECURE_LOCAL_CONTROL_PLANE_HTTP=true
export PUBLIC_BASE_URL=http://127.0.0.1:3000
export SNAPSHOT_INTERVAL_SECONDS=300
export IDLE_TIMEOUT_SECONDS=300

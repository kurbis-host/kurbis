# Copying this file to .env is handled by ./start.sh on first run.
# Generated secrets are filled in automatically. Replace deployment values.
POSTGRES_USER=kurbis
POSTGRES_PASSWORD=GENERATE_ON_FIRST_START
POSTGRES_DB=kurbis_hoster
DATABASE_PORT=55432
CONTROL_PLANE_PORT=18080
NATIVE_DATABASE_PORT=5432
DATABASE_URL_NATIVE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${NATIVE_DATABASE_PORT}/${POSTGRES_DB}

PUBLIC_BASE_URL=https://panel.example.com
ROOT_DOMAIN=mc.example.com
WORKER_ADDRESS=203.0.113.10
# Public Gateway endpoint advertised in NetherNet ICE SDP; it must resolve back
# through the shared Gateway relay, not directly to this worker.
BEDROCK_PUBLIC_IP=203.0.113.10
BEDROCK_PUBLIC_PORT=19132

GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
DISCORD_OAUTH_CLIENT_ID=replace-me
DISCORD_OAUTH_CLIENT_SECRET=replace-me

# Optional Pumpkin PR / branch preview service. Leave the PAT empty to disable.
# The builder is a dedicated rootless Docker daemon reachable over restricted SSH;
# the SSH account must be non-root and its own Docker endpoint must be rootless.
# Do not use ssh://root@host, /var/run/docker.sock, or Podman. Docker mode
# remains available for a dedicated rootless daemon. Respond5 control-plane
# deployments may select bubblewrap_ssh: only the build job is sent to the
# non-root SSH target; the watcher, Check Run client, artifact cache, and worker
# stay on respond5. CI_BUBBLEWRAP_RUNNER and all CI_BUBBLEWRAP_* paths are
# paths on the private builder host, never host-mounted into Compose. The only
# host path mounted into the respond5 control plane is CI_BUILDER_SSH_HOST_DIRECTORY,
# which contains a dedicated key/config/known_hosts set owned by UID 65532.
# The active polling target is fixed to the upstream Pumpkin repository.
CI_REPOSITORY=Pumpkin-MC/Pumpkin
CI_GITHUB_PAT=
# GitHub request guard: durable shared core-quota pacing and rate-limit backoff.
# Minimum request spacing (milliseconds), max rate-limit pause (seconds), and
# bounded exponential-jitter fraction. State is persisted in PostgreSQL.
CI_GITHUB_MIN_REQUEST_INTERVAL_MS=2000
CI_GITHUB_RATE_LIMIT_MAX_BACKOFF_SECS=900
CI_GITHUB_RATE_LIMIT_JITTER=0.2
# Polling is the active CI event source. Leave webhooks disabled unless you explicitly opt in.
CI_GITHUB_WEBHOOK_ENABLED=false
# Post a Check Run with the preview address on each pull request of the
# watched repository. Off by default; needs a token allowed to write checks,
# which GitHub grants to GitHub App tokens, not personal access tokens.
CI_GITHUB_CHECK_RUNS_ENABLED=false
CI_GITHUB_CHECK_RUNS_TOKEN=
# Only required when CI_GITHUB_WEBHOOK_ENABLED=true.
CI_GITHUB_WEBHOOK_SECRET=
CI_DEFAULT_BRANCH=master
# Explicit backend selection. Docker remains the default; bubblewrap is a
# deliberate namespace-only opt-in and never falls back to Docker.
CI_BUILDER_BACKEND=docker
CI_BUILDER_IMAGE=registry.example/kurbis/pumpkin-ci-builder@sha256:replace-with-64-hex-digest
CI_TOOLCHAIN_VERSION=1.98.1
CI_BUILDER_DOCKER_HOST=ssh://ci-builder@builder.example.net
# Bubblewrap is a deliberate namespace-only opt-in. Use bubblewrap for a native
# Linux control plane, or bubblewrap_ssh when the control plane is on respond5
# and the build-only namespace lives on a dedicated lxhalle account.
CI_BUILDER_SSH_TARGET=ci@builder.example.net
# Host path on respond5 for the read-only SSH mount; keep private files out of Git.
CI_BUILDER_SSH_HOST_DIRECTORY=/etc/dokploy/secrets/kurbis-hoster/ci-builder-ssh
# All following paths are absolute paths on lxhalle, not paths in the Compose container.
CI_BUBBLEWRAP_RUNNER=/var/tmp/kurbis-ci-bubblewrap-20261007/runner/ci_bubblewrap_runner.py
# Bubblewrap-only immutable host inputs (required for native Bubblewrap mode).
# For bubblewrap_ssh, CI_BUBBLEWRAP_WORKSPACE is a private HOME anchor; the
# remote runner mounts the exact size=5G,nr_inodes=1310720 tmpfs per job inside
# its user/mount namespace. For direct native bubblewrap it must already be that
# operator-mounted tmpfs. Ordinary directories and other limits are rejected.
# The other paths are immutable operator-owned inputs.
CI_BUBBLEWRAP_PATH=/usr/bin/bwrap
CI_BUBBLEWRAP_ROOTFS=/var/tmp/kurbis-ci-bubblewrap-20261007/rootfs/current
CI_BUBBLEWRAP_TOOLCHAIN=/var/tmp/kurbis-ci-bubblewrap-20261007/toolchain/current
CI_BUBBLEWRAP_WORKSPACE=/home/ci/.cache/kurbis/ci/workspace-tmpfs
CI_BUBBLEWRAP_SOURCE_PREPARER=/var/tmp/kurbis-ci-bubblewrap-20261007/bin/ci-source-preparer
# Maximum concurrent builds per concrete builder identity (1-64; default 2).
# Admission reserves each build's memory plus system headroom across processes.
CI_BUILD_CONCURRENCY=2
# Native start.sh resolves this relative to the checkout; compose.yaml overrides
# it to /opt/kurbis/plugins/kurbis-control inside the control-plane image.
CI_PLUGIN_SOURCE=plugins/kurbis-control

# Optional in-game AI assistant (/ai). Leave the provider empty to turn it off.
# Budgets are monthly US dollar caps; a server never spends more than its
# owner's account budget. Blank values keep the defaults shown in comments.
# `control-plane check-ai` runs one tool round with every offered model.
# anthropic (Messages API) or openai (any OpenAI-compatible Chat Completions API)
AI_PROVIDER=
# API root; https://api.anthropic.com/v1 for anthropic, required for openai,
# e.g. http://ollama:11434/v1
AI_BASE_URL=
# Required for anthropic, sent as a bearer token to openai endpoints when set
AI_API_KEY=
# Offered models, the first is the default; claude-opus-5-5,claude-sonnet-5-5,
# claude-haiku-5-5 for anthropic, required for openai. Claude models are
# charged at Anthropic's prices; other models only when priced as
# id=INPUT/OUTPUT in US dollars per million tokens, e.g. gpt-oss-120b=0.15/0.6
AI_MODELS=
# low, medium or high
AI_DEFAULT_EFFORT=
# 5
AI_SERVER_MONTHLY_BUDGET_USD=
# 20
AI_ACCOUNT_MONTHLY_BUDGET_USD=
# Model calls in flight across all servers; 16
AI_MAX_CONCURRENT_CALLS=

INTERNAL_TOKEN=GENERATE_ON_FIRST_START
BUILD_REVISION=development
# Host directory containing trusted fullchain.pem and private privkey.pem for Docker Bedrock TLS.
BEDROCK_TLS_HOST_DIRECTORY=./data/certs
PUMPKIN_GATEWAY_CONTROL_TOKEN=GENERATE_ON_FIRST_START
WORKER_ID=GENERATE_ON_FIRST_START
WORKER_NAME=primary-worker
WORKER_SIGNAL_ADDRESS=127.0.0.1
# This example targets local loopback services. Set false for non-local worker bundles.
WORKER_ALLOW_INSECURE_LOCAL_CONTROL_PLANE_HTTP=true
# Only the per-runtime managed-plugin proxy is attached to this egress network.
# This default targets the local Compose control plane; remote workers should use
# an HTTPS upstream and a dedicated egress network that can reach it.
WORKER_RUNTIME_API_PROXY_UPSTREAM=http://control-plane:8080
WORKER_RUNTIME_API_EGRESS_NETWORK=kurbis-hoster_runtime-api-egress
WORKER_RUNTIME_API_PROXY_IMAGE=melon-hoster:local
WORKER_MEMORY_GIB=16
WORKER_DISK_GIB=100
WORKER_CPU_MILLIS=4000
WORKER_PORT_MIN=20000
WORKER_PORT_MAX=40000
WORKER_STORAGE_MODE=directory
WORKER_ROOT=./data/worker

OBJECT_STORE_TYPE=local
OBJECT_STORE_LOCAL_ROOT=./data/objects
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ALLOW_HTTP=false

PANEL_BIND_ADDRESS=127.0.0.1
PANEL_PORT=3000
JAVA_PORT=25565
JAVA_PUBLIC_PORT=${JAVA_PORT}
BEDROCK_PORT=${BEDROCK_PUBLIC_PORT}
DOCKER_SUBNET=172.31.250.0/24
WAITING_IP=172.31.250.10
GATEWAY_IP=172.31.250.11
# The private address the Gateway uses as its source on worker connections.
# This is distinct from BEDROCK_PUBLIC_IP, which clients use for shared ICE relay.

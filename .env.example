# Copying this file to .env is handled by ./start.sh on first run.
# Generated secrets are filled in automatically. Replace deployment values.
POSTGRES_USER=kurbis
POSTGRES_PASSWORD=GENERATE_ON_FIRST_START
POSTGRES_DB=kurbis_hoster
DATABASE_PORT=55432
CONTROL_PLANE_PORT=18080
NATIVE_DATABASE_PORT=5432
DATABASE_URL_NATIVE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${NATIVE_DATABASE_PORT}/${POSTGRES_DB}

PUBLIC_BASE_URL=https://panel.example.com
ROOT_DOMAIN=mc.example.com
WORKER_ADDRESS=203.0.113.10
# Public Gateway endpoint advertised in NetherNet ICE SDP; it must resolve back
# through the shared Gateway relay, not directly to this worker.
BEDROCK_PUBLIC_IP=203.0.113.10
BEDROCK_PUBLIC_PORT=19132

GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
DISCORD_OAUTH_CLIENT_ID=replace-me
DISCORD_OAUTH_CLIENT_SECRET=replace-me

# Optional Pumpkin PR / branch preview service. Leave the PAT empty to disable.
# The builder is a dedicated rootless Docker daemon reachable over restricted SSH;
# do not mount a host Docker socket into the control-plane container.
CI_GITHUB_PAT=
# Polling is the active CI event source. Leave webhooks disabled unless you explicitly opt in.
CI_GITHUB_WEBHOOK_ENABLED=false
# Only required when CI_GITHUB_WEBHOOK_ENABLED=true.
CI_GITHUB_WEBHOOK_SECRET=
CI_DEFAULT_BRANCH=main
CI_BUILDER_IMAGE=registry.example/kurbis/pumpkin-ci-builder@sha256:replace-with-64-hex-digest
CI_TOOLCHAIN_VERSION=1.98.1
CI_BUILDER_DOCKER_HOST=ssh://ci-builder@builder.example.net
CI_PLUGIN_SOURCE=/opt/kurbis/plugins/kurbis-control

INTERNAL_TOKEN=GENERATE_ON_FIRST_START
PUMPKIN_GATEWAY_CONTROL_TOKEN=GENERATE_ON_FIRST_START
WORKER_ID=GENERATE_ON_FIRST_START
WORKER_NAME=primary-worker
WORKER_SIGNAL_ADDRESS=127.0.0.1
# This example targets local loopback services. Set false for non-local worker bundles.
WORKER_ALLOW_INSECURE_LOCAL_CONTROL_PLANE_HTTP=true
# Only the per-runtime managed-plugin proxy is attached to this egress network.
# This default targets the local Compose control plane; remote workers should use
# an HTTPS upstream and a dedicated egress network that can reach it.
WORKER_RUNTIME_API_PROXY_UPSTREAM=http://control-plane:8080
WORKER_RUNTIME_API_EGRESS_NETWORK=kurbis-hoster_runtime-api-egress
WORKER_RUNTIME_API_PROXY_IMAGE=melon-hoster:local
WORKER_MEMORY_GIB=16
WORKER_DISK_GIB=100
WORKER_CPU_MILLIS=4000
WORKER_PORT_MIN=20000
WORKER_PORT_MAX=40000
WORKER_STORAGE_MODE=directory
WORKER_ROOT=./data/worker

OBJECT_STORE_TYPE=local
OBJECT_STORE_LOCAL_ROOT=./data/objects
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ALLOW_HTTP=false

PANEL_PORT=3000
JAVA_PORT=25565
JAVA_PUBLIC_PORT=${JAVA_PORT}
BEDROCK_PORT=${BEDROCK_PUBLIC_PORT}
DOCKER_SUBNET=172.31.250.0/24
WAITING_IP=172.31.250.10
GATEWAY_IP=172.31.250.11
# The private address the Gateway uses as its source on worker connections.
# This is distinct from BEDROCK_PUBLIC_IP, which clients use for shared ICE relay.

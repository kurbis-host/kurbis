# Copying this file to .env is handled by ./start.sh on first run.
# Generated secrets are filled in automatically. Replace deployment values.
POSTGRES_USER=kurbis
POSTGRES_PASSWORD=GENERATE_ON_FIRST_START
POSTGRES_DB=kurbis_hoster
DATABASE_PORT=55432
NATIVE_DATABASE_PORT=5432
DATABASE_URL_NATIVE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${NATIVE_DATABASE_PORT}/${POSTGRES_DB}

PUBLIC_BASE_URL=https://panel.example.com
ROOT_DOMAIN=mc.example.com
WORKER_ADDRESS=203.0.113.10

GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
DISCORD_OAUTH_CLIENT_ID=replace-me
DISCORD_OAUTH_CLIENT_SECRET=replace-me

INTERNAL_TOKEN=GENERATE_ON_FIRST_START
PUMPKIN_GATEWAY_CONTROL_TOKEN=GENERATE_ON_FIRST_START
PUMPKIN_HOST_CONTROL_TOKEN=GENERATE_ON_FIRST_START
WORKER_ID=GENERATE_ON_FIRST_START
WORKER_NAME=primary-worker
WORKER_MEMORY_GIB=16
WORKER_DISK_GIB=100
WORKER_CPU_MILLIS=4000
WORKER_PORT_MIN=20000
WORKER_PORT_MAX=40000
WORKER_STORAGE_MODE=directory
WORKER_ROOT=./data/worker

OBJECT_STORE_TYPE=local
OBJECT_STORE_LOCAL_ROOT=./data/objects
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ALLOW_HTTP=false

PANEL_PORT=3000
JAVA_PORT=25565
BEDROCK_PORT=19132
DOCKER_SUBNET=172.31.250.0/24
WAITING_IP=172.31.250.10
GATEWAY_IP=172.31.250.11

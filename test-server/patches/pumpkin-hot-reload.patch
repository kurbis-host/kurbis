     }
+
+    /// Removes every registered permission owned by a namespace.
+    ///
+    /// Player attachments are intentionally not touched so explicit grants survive a
+    /// plugin hot reload and become active again if the plugin re-registers the node.
+    pub fn unregister_namespace(&self, namespace: &str) {
+        let prefix = format!("{namespace}:");
+        self.permissions
+            .retain(|node, _| !node.starts_with(&prefix));
+    }
 }
 
 /// Storage for player permissions.
@@ -452,3 +462,24 @@ impl<'de> Deserialize<'de> for PermissionLvl {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unregister_namespace_only_removes_owned_permissions() {
+        let registry = PermissionRegistry::new();
+        for node in ["demo:command.one", "demo:command.two", "other:command.one"] {
+            registry
+                .register_permission(Permission::new(node, "test", PermissionDefault::Allow))
+                .expect("register permission");
+        }
+
+        registry.unregister_namespace("demo");
+
+        assert!(!registry.has_permission("demo:command.one"));
+        assert!(!registry.has_permission("demo:command.two"));
+        assert!(registry.has_permission("other:command.one"));
+    }
+}
